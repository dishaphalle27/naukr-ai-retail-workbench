# Copy this file to .env and fill it in. NEVER commit the real .env file.
# The app works fully with NO key: it falls back to the built-in rules planner.

# none = rules only (default) | gemini = AI planner with automatic fallback to rules
LLM_PROVIDER=none

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Model name. Check Google AI Studio for the current free-tier model and change this if needed.
LLM_MODEL=gemini-3.5-flash

LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2

MAX_UPLOAD_MB=20
MAX_RESULT_ROWS=100
LLM_MODE=ai_first
